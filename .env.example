# Runtime only: Neon pooled URL; the hostname must contain -pooler.
DATABASE_URL=postgresql://USER:PASSWORD@EP-EXAMPLE-pooler.REGION.aws.neon.tech/DBNAME?sslmode=require
# Direct Neon URL for one-off schema migrations only. Never use this in runtime code.
MIGRATION_DATABASE_URL=postgresql://USER:PASSWORD@EP-EXAMPLE.REGION.aws.neon.tech/DBNAME?sslmode=require
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-long-random-password
SESSION_SECRET=replace-with-at-least-32-random-bytes
PORT=10000
